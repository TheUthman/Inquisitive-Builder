# Clerk publishable key from your Clerk Dashboard (safe to expose in frontend builds)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Your Clerk user ID (frontend route gate only; enforce this allowlist again in the backend)
VITE_CLERK_ADMIN_USER_ID=user_replace_me

# Optional: backend API base URL. Leave blank to use the Vite proxy /api/v1 default.
VITE_API_BASE_URL=
